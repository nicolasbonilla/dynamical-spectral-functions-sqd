# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# LaTeX build artifacts (keep main.pdf, ignore the rest)
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
paper/*.aux
paper/*.log
paper/figs/*.aux
paper/figs/*.log

# Scaling checkpoints (regenerated by scaling_lanczos_mf.py)
ckpt/

# Scratch build directory created on demand by src/make_table.py (via `make figures`).
# It is NOT part of the deposit: paper/table_molecules.tex is the authoritative table.
rebuild/

# Stale / backup data (NOT the plotted data — see docs/FIGURE_PROVENANCE.md)
*_backup.json
*_dense_backup.json

# OS
.DS_Store
Thumbs.db

# Secrets — never commit credentials
.ibm_credentials
*token*.txt

# Non-deposited by-products written by the generators (run logs, intermediate
# rasters).  The deposit itself is data/ and paper/figs/; build/ is scratch.
build/

# NOTE (2026-09-18): .github/workflows/ci.yml used to be listed here, which meant
# the CI badge advertised a workflow that was never in the repository at all --
# not broken, ABSENT.  The exclusion is removed; the workflow is now tracked.
